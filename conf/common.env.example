# Configuration commune à tous les lanceurs : copier en conf/common.env
# Fichier lu par bash : VARIABLE=valeur, guillemets simples si la valeur contient des espaces.

# ---------------------------------------------------------------- Docker (lu par les lanceurs)
ICEMAINT_IMAGE=icemaint:0.2.0
# Plafonds du conteneur : Polaris et PostgreSQL tournent sur la même VM, ne pas les affamer
ICEMAINT_DOCKER_CPUS=2
ICEMAINT_DOCKER_MEMORY=4g
# Réseau Docker : celui du compose Polaris (docker inspect polaris-server), pour joindre Polaris par son nom.
# « host » est refusé si le démon Docker a les user namespaces activés.
ICEMAINT_DOCKER_NETWORK='<reseau du compose Polaris>'

# ---------------------------------------------------------------- Spark (dans le conteneur)
# Cœurs et mémoire Spark : rester sous les plafonds Docker (mémoire Spark ≈ 75 % de ICEMAINT_DOCKER_MEMORY)
ICEMAINT_SPARK_CORES=2
ICEMAINT_SPARK_MEMORY=3g
# Forcer le codec Parquet des fichiers réécrits si Teradata ne relit pas ceux par défaut
# ICEMAINT_COMPRESSION_CODEC=snappy

# ---------------------------------------------------------------- Polaris
POLARIS_URI=http://polaris-server:8181/api/catalog
POLARIS_CATALOG='<nom du catalogue Polaris>'
POLARIS_SCOPE=PRINCIPAL_ROLE:ALL

# ---------------------------------------------------------------- S3 (ECS)
S3_ENDPOINT='https://<hote-ecs>:<port>'
S3_PATH_STYLE_ACCESS=true
S3_REGION=us-east-1

# Compatibilité du SDK AWS récent avec un S3 on-prem (sommes de contrôle seulement si requises)
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# ---------------------------------------------------------------- PKI interne
# Magasin de confiance Java du système (contient les AC internes), comme pour Polaris.
# Le dossier est monté en lecture seule dans le conteneur, en /opt/icemaint/tls.
ICEMAINT_TLS_DIR=/etc/pki/ca-trust/extracted/java
JAVA_TOOL_OPTIONS='-Djavax.net.ssl.trustStore=/opt/icemaint/tls/cacerts'
