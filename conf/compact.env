# compact : compaction bin-pack (rewrite_data_files)
# La table vient du fichier job passé par $U (ICEMAINT_TABLE=namespace.table, liste, ou namespace.*).

# Taille cible des fichiers réécrits
ICEMAINT_TARGET_FILE_SIZE_MB=512
# Nombre minimal de petits fichiers pour qu'un groupe soit réécrit
ICEMAINT_MIN_INPUT_FILES=5
# Groupes réécrits en parallèle : au plus ICEMAINT_SPARK_CORES
ICEMAINT_MAX_CONCURRENT=2
# Taille maximale d'un groupe ; chaque groupe terminé est validé sans attendre la fin du job
ICEMAINT_MAX_GROUP_SIZE_GB=10
# Limiter aux partitions récentes (filtre SQL Spark), à mettre plutôt dans le fichier job
# ICEMAINT_WHERE="jour >= '2026-11-01'"
