# td-load : copie une table Teradata vers une table Iceberg (INSERT INTO ... SELECT, colonnes par nom).
# La source, la cible et le filtre viennent du fichier job (ICEMAINT_TD_SOURCE, ICEMAINT_TD_TARGET, ICEMAINT_TD_WHERE).
# La table cible doit exister (CREATE TABLE côté Teradata).

ICEMAINT_DOCKER_CPUS=1
ICEMAINT_DOCKER_MEMORY=1g

# SIMULATION par défaut : contrôle la connexion, les colonnes et le nombre de lignes, sans rien écrire.
# Mettre false pour copier réellement.
ICEMAINT_DRY_RUN=true
