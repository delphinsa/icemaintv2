# Secrets : copier en conf/secrets.env puis « chmod 600 conf/secrets.env ». Ne jamais versionner.

# Principal Polaris de la maintenance (voir README, étape 2)
POLARIS_CLIENT_ID='<client_id>'
POLARIS_CLIENT_SECRET='<secret>'

# Clés S3 avec droits lecture, écriture, listage ET suppression sur le bucket
S3_ACCESS_KEY_ID='<cle-acces>'
S3_SECRET_ACCESS_KEY='<cle-secrete>'

# Compte Teradata pour td-sql et td-load (facultatif si ces commandes ne servent pas).
# Utiliser un compte dédié, limité à la lecture des bases sources et à l'écriture dans le serveur Iceberg,
# pas un compte SYSDBA.
TERADATA_HOST='<hote-teradata>'
TERADATA_USER='<compte-dedie>'
TERADATA_PASSWORD='<mot-de-passe>'
# Facultatif : mécanisme d'authentification et port si différents des valeurs par défaut
# TERADATA_LOGMECH=TD2
# TERADATA_DBS_PORT=1025
