# td-sql : exécute un script SQL du dossier conf/sql sur Teradata (INSERT dans une table Iceberg, SELECT, DDL...).
# Le fichier vient du fichier job passé par $U (ICEMAINT_TD_FILE=nom.sql, relatif à conf/sql).
# Les identifiants Teradata sont dans conf/secrets.env (TERADATA_HOST, TERADATA_USER, TERADATA_PASSWORD).

# Pas de Spark dans cette commande : un petit conteneur suffit, Teradata fait le travail.
ICEMAINT_DOCKER_CPUS=1
ICEMAINT_DOCKER_MEMORY=1g

# SIMULATION par défaut : seules les lectures (SELECT, SHOW, HELP, EXPLAIN) sont exécutées.
# Les INSERT, DDL, DELETE... sont listés sans être exécutés. Mettre false pour les exécuter.
ICEMAINT_DRY_RUN=true

# Séparateur de plusieurs instructions dans un même fichier : une ligne contenant uniquement ce texte
ICEMAINT_TD_DELIMITER=-----
# Lignes affichées au maximum pour un SELECT
ICEMAINT_TD_LIMIT=20
