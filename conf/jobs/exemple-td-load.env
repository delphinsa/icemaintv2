# Fichier job td-load : une copie Teradata -> Iceberg.
#   bin/td-load.sh conf/jobs/exemple-td-load.env
# Pour exécuter réellement : ICEMAINT_DRY_RUN=false (ou -- --apply en fin de commande).

ICEMAINT_TD_SOURCE=DB_DWH_VALO_RGCU_DEV.ELCARB
ICEMAINT_TD_TARGET=iceberg_onprem_s3_polaris_POC.RGCU.ELCARB_10GO_ICEBERG_WITH_TBLPROP
# Filtre Teradata (facultatif)
ICEMAINT_TD_WHERE="ecb_gen = 1961"
