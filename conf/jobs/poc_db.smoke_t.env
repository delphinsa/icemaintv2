# Fichier « job » : un par table (ou groupe de tables), passé en argument par $U.
# Il surcharge conf/common.env et conf/<commande>.env.
#   bin/compact.sh conf/jobs/exemple-poc_db.t_ventes.env

ICEMAINT_TABLE=poc_db.smoke_t

