# remove-orphans : suppression des fichiers non référencés sous l'emplacement de la table
# ATTENTION : opération la plus risquée. Rester en simulation plusieurs semaines,
# et ne pas l'exécuter pendant la migration ECS -> Hitachi.

# Âge minimal des fichiers supprimés : doit dépasser la durée de la plus longue écriture
ICEMAINT_OLDER_THAN_DAYS=3
# true = simulation
ICEMAINT_DRY_RUN=true
