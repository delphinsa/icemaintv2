# purge : suppression de lignes selon une règle de conservation (une seule table par job)
# Le filtre est obligatoire et se met dans le fichier job, par exemple :
#   ICEMAINT_WHERE="date_evenement < date_sub(current_date(), 3650)"
# Les lignes restent lisibles en time travel jusqu'à l'expiration des snapshots.

# true = simulation (compte les lignes concernées)
ICEMAINT_DRY_RUN=true
