# expire-snapshots : expiration des anciens snapshots
# ATTENTION : irréversible (plus de time travel ni de rollback avant la date limite).
# La rétention doit couvrir l'âge de la plus ancienne sauvegarde PostgreSQL restaurable.

ICEMAINT_OLDER_THAN_DAYS=7
ICEMAINT_RETAIN_LAST=5
# true = simulation ; passer à false après validation des simulations
ICEMAINT_DRY_RUN=true
